# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────
# IMPORTANT: Include the database name in the URI (e.g. /trademind)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/trademind?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── CORS ───────────────────────────────────────
CLIENT_ORIGIN=https://your-frontend.vercel.app,https://your-preview.vercel.app

# ── ML Service ─────────────────────────────────
ML_SERVICE_URL=https://trademind-ai-1.onrender.com

# ── Gemini AI ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=12000

# ── AI Insight ─────────────────────────────────
AI_INSIGHT_CACHE_TTL=180
NEWS_TIMEOUT_MS=5000

# ── NewsAPI.org ────────────────────────────────
NEWS_API_KEY=your_newsapi_key

# ── Redis ──────────────────────────────────────
REDIS_HOST=your-redis-host.redislabs.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# â”€â”€ Market Stream â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Yahoo WebSocket stale threshold before REST fallback kicks in.
MARKET_STREAM_STALE_MS=20000
MARKET_STREAM_FALLBACK_POLL_MS=12000
